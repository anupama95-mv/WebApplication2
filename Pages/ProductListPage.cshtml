@page
@model WebApplication2.Pages.ProductListPageModel
@{
    Layout = "_MasterLayout";
}

<!-- ✅ jQuery -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<!-- ✅ DataTables CSS -->
<link href="~/css/dataTables.dataTables.min.css" rel="stylesheet" />

<!-- ✅ DataTables JS -->
<script src="~/js/datatables.min.js"></script>

<div class="content-wrapper">

    <section class="content-header">
        <div class="container-fluid">
            <h2>Product List</h2>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">

            <div class="card">
                <div class="card-body">

                    <table id="myTable" class="display table table-bordered table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>

                </div>
            </div>

        </div>
    </section>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

    let table = new DataTable('#myTable', {
    data: [
    { id: 1, product: "Pen", price: 10 },
    { id: 2, product: "Book", price: 50 },
    { id: 3, product: "Pencil", price: 5 }
    ],

    columns: [
    { data: 'id' },
    { data: 'product' },
    { data: 'price' },
    {
    data: 'id',
    render: function (data) {
    return `
    <button class="btn btn-success btn-sm" onclick="editItem(${data})">Edit</button>
    <button class="btn btn-danger btn-sm" onclick="deleteItem(${data})">Delete</button>
    `;
    }
    }
    ]
    });

    });

    function editItem(id) {
    window.location.href = '/EditProduct?id=' + id;
    }

    function deleteItem(id) {
    if (confirm("Are you sure you want to delete this product?")) {
    window.location.href = '/DeleteProduct?id=' + id;
    }
    }
</script>