@page
@model WebApplication2.Pages.DeleteProductModel
@{
    Layout = "_MasterLayout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white text-center">
                    <h4>Delete Product</h4>
                </div>

                <div class="card-body text-center">

                    <p>Are you sure you want to delete this product?</p>

                    <p><strong>Id:</strong> @Model.Product.Id</p>
                    <p><strong>Name:</strong> @Model.Product.ProductName</p>
                    <p><strong>Price:</strong> @Model.Product.Price</p>

                    <form method="post">
                        <input type="hidden" asp-for="Product.Id" />

                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a href="/ProductListPage" class="btn btn-secondary">Cancel</a>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
